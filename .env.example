# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every value here is optional — Eco-Loop auto-discovers sane defaults and
# `ecoloop doctor` will tell you exactly which of these you need to set.

# --- EnergyPlus -----------------------------------------------------------
# Root of the EnergyPlus installation. `pyenergyplus` is NOT on PyPI: it lives
# inside this directory and Eco-Loop injects it onto sys.path at runtime.
# Leave unset to rely on auto-discovery of standard install locations.
ENERGYPLUS_DIR=/Users/you/.local/opt/EnergyPlus-25.2.0

# --- LLM endpoint ---------------------------------------------------------
# Any OpenAI-compatible server works (Ollama, vLLM, llama.cpp, LM Studio).
ECOLOOP_LLM__BASE_URL=http://localhost:11434
ECOLOOP_LLM__MODEL=qwen2.5:7b-instruct

# Only needed for endpoints that authenticate. Ollama does not.
ECOLOOP_LLM_API_KEY=

# --- overrides ------------------------------------------------------------
# Any config key can be overridden with the ECOLOOP_ prefix and `__` nesting.
# ECOLOOP_AGENT__CADENCE_MINUTES=60
# ECOLOOP_LOGGING__LEVEL=DEBUG
